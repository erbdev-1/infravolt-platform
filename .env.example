# Public configuration — required in production
# Safe local origins only; replace through environment management outside Git.
NEXT_PUBLIC_SITE_URL_UK=http://uk.infravolt.localhost:3000
NEXT_PUBLIC_SITE_URL_UA=http://ua.infravolt.localhost:3000

# Server-only SEO launch gate. Keep false until the explicit production indexing launch step.
SITE_INDEXING_ENABLED=false

# Public configuration — optional until the corresponding surface/provider exists
NEXT_PUBLIC_PROTECTED_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GA4 Measurement ID (not a secret — this is the public gtag config value,
# e.g. "G-XXXXXXXXXX"). Analytics stays fully inactive when this is unset:
# no gtag.js script tag, no dataLayer network activity. Even when set,
# nothing loads until a visitor explicitly accepts the analytics cookie
# banner, and only on the exact production hosts infravolt.co.uk /
# infravolt.com.ua — see src/modules/analytics/.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------
# CLOUDFLARE R2 — SERVER ONLY
# NEVER expose these as NEXT_PUBLIC_*
# ---------------------------------------------------------

R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_NEW_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_NEW_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=infravolt-public-assets

# Server-only secrets — optional until the corresponding provider exists; never commit values
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
EODHD_API_KEY=

# Server-only email configuration — optional until Resend integration
EMAIL_FROM_UK=
EMAIL_REPLY_TO_UK=
EMAIL_FROM_UA=
EMAIL_REPLY_TO_UA=

# Server-only operational configuration — optional; accepted values: debug, info, warn, error
LOG_LEVEL=
